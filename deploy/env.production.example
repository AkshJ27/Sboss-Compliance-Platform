# Production settings for the server. Copy to /opt/sboss-compliance/backend/.env and fill in the <...> values.
# Never commit the real .env: it holds the database password and the Azure secret.

NODE_ENV=production
PORT=4000

# RDS PostgreSQL: the endpoint from the RDS console, the master user and password you chose
DATABASE_URL="postgresql://compliance_admin:<RDS password>@<RDS endpoint>:5432/compliance?schema=public&sslmode=require"

# A long random secret: run  openssl rand -base64 48  and paste the result
JWT_SECRET=<paste the random secret>

CORS_ORIGIN=https://sboss-compliance.sboss.net.in
APP_URL=https://sboss-compliance.sboss.net.in

# Proof files go to S3. The server's IAM role gives access, so no keys are needed here.
STORAGE_DRIVER=s3
S3_BUCKET=<your bucket name>
AWS_REGION=ap-south-1

# Email: keep "file" until UAT users are told, then switch to outlook
EMAIL_DRIVER=file
AZURE_SENDER_EMAIL=sboss.notification@sboss.net.in
AZURE_TENANT_ID=<tenant id>
AZURE_CLIENT_ID=<client id>
AZURE_CLIENT_SECRET=<client secret>

# Daily reminder email at 8 am India time
RUN_JOBS=true
DIGEST_HOUR=8

# true only until the first admin is registered, then false
ALLOW_REGISTRATION=false

RATE_LIMIT_PER_15_MIN=5000
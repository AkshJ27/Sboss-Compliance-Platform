NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://app:app_dev_password@localhost:5432/compliance?schema=public"
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
EMAIL_DRIVER=file
OUTBOX_DIR=./outbox
APP_URL=http://localhost:5173
RUN_JOBS=true
DIGEST_HOUR=8
ALLOW_REGISTRATION=true
# Set ALLOW_REGISTRATION=false in production, and set APP_URL to your public site address
# Production on AWS:
# EMAIL_DRIVER=ses
# EMAIL_FROM=Compliance Platform <alerts@yourdomain.com>
# For production on AWS, use these instead:
# STORAGE_DRIVER=s3
# S3_BUCKET=
# AWS_REGION=ap-south-1
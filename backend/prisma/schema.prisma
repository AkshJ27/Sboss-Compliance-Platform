generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORG_ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  entities       Entity[]
  verticals      Vertical[]
  departments    Department[]
  locationTypes  LocationType[]
  locations      Location[]
  financialYears FinancialYear[]
  auditLogs      AuditLog[]
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]
   instanceEvents InstanceEvent[]

}

model User {
  id               String    @id @default(uuid())
  orgId            String
  email            String    @unique
  name             String
  passwordHash     String
  role             Role      @default(MEMBER)
  isActive         Boolean   @default(true)
  isPlatformAdmin  Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
 instanceEvents InstanceEvent[]
  @@index([orgId])
  
  ownedSchedules    ComplianceSchedule[] @relation("ScheduleOwner")
  managedSchedules  ComplianceSchedule[] @relation("ScheduleManager")
  approvedSchedules ComplianceSchedule[] @relation("ScheduleApprover")
  ownedInstances    ComplianceInstance[] @relation("InstanceOwner")
  managedInstances  ComplianceInstance[] @relation("InstanceManager")
  approvedInstances ComplianceInstance[] @relation("InstanceApprover")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Entity {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([orgId, name])
  @@unique([orgId, code])
  @@index([orgId])
}

model Vertical {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

model Department {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

model LocationType {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Location {
  id             String   @id @default(uuid())
  orgId          String
  entityId       String
  locationTypeId String?
  name           String
  state          String
  city           String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entity       Entity        @relation(fields: [entityId], references: [id])
  locationType LocationType? @relation(fields: [locationTypeId], references: [id])

  @@unique([entityId, name])
  @@index([orgId, entityId])
  @@index([orgId, state])
}

model FinancialYear {
  id        String   @id @default(uuid())
  orgId     String
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, label])
  @@index([orgId, startDate])
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  userId     String?
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, entityId])
  @@index([orgId, createdAt])
}

enum Jurisdiction {
  CENTRAL
  STATE
}

enum Frequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  EVENT_BASED
}

enum PeriodBasis {
  FINANCIAL_YEAR
  CALENDAR_YEAR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AttachmentRule {
  MANDATORY
  OPTIONAL
  NOT_REQUIRED
}

model LawCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  acts      Act[]
}

model StatutoryAuthority {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  acts      Act[]
}

model ComplianceNature {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  compliances Compliance[]
}

model ComplianceType {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  compliances Compliance[]
}

model Act {
  id                   String       @id @default(uuid())
  name                 String
  jurisdiction         Jurisdiction
  state                String?
  lawCategoryId        String
  statutoryAuthorityId String?
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  lawCategory        LawCategory         @relation(fields: [lawCategoryId], references: [id])
  statutoryAuthority StatutoryAuthority? @relation(fields: [statutoryAuthorityId], references: [id])
  rules              Rule[]
  compliances        Compliance[]

  @@unique([name, jurisdiction, state])
  @@index([lawCategoryId])
  @@index([state])
}

model Rule {
  id        String   @id @default(uuid())
  actId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  act         Act          @relation(fields: [actId], references: [id])
  compliances Compliance[]

  @@unique([actId, name])
  @@index([actId])
}

model Compliance {
  id                String         @id @default(uuid())
  code              String         @unique
  actId             String
  ruleId            String?
  natureId          String?
  typeId            String?
  title             String
  description       String?
  form              String?
  reference         String?
  risk              RiskLevel      @default(MEDIUM)
  impact            RiskLevel      @default(MEDIUM)
  attachment        AttachmentRule @default(OPTIONAL)
  frequency         Frequency
  periodBasis       PeriodBasis    @default(FINANCIAL_YEAR)
  dueDay            Int?
  dueMonthOffset    Int            @default(0)
  event             String?
  dueDaysAfterEvent Int?
  penalty           String?
  imprisonment      Boolean        @default(false)
  isActive          Boolean        @default(true)
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]

  act       Act                  @relation(fields: [actId], references: [id])
  rule      Rule?                @relation(fields: [ruleId], references: [id])
  nature    ComplianceNature?    @relation(fields: [natureId], references: [id])
  type      ComplianceType?      @relation(fields: [typeId], references: [id])
  revisions ComplianceRevision[]

  @@index([actId])
  @@index([ruleId])
  @@index([frequency])
  @@index([risk])
  @@index([isActive])
}

model ComplianceRevision {
  id           String   @id @default(uuid())
  complianceId String
  version      Int
  changes      Json
  changedById  String?
  createdAt    DateTime @default(now())

  compliance Compliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)

  @@unique([complianceId, version])
  @@index([complianceId])
}

enum InstanceStatus {
  DUE
  SUBMITTED
  MANAGER_APPROVED
  CLOSED
  RETURNED
  NOT_APPLICABLE
}

model ComplianceSchedule {
  id           String   @id @default(uuid())
  orgId        String
  complianceId String
  entityId     String
  locationId   String
  departmentId String?
  verticalId   String?
  ownerId      String
  managerId    String
  approverId   String?
  startDate    DateTime @db.Date
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  compliance Compliance   @relation(fields: [complianceId], references: [id])
  entity     Entity       @relation(fields: [entityId], references: [id])
  location   Location     @relation(fields: [locationId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])
  vertical   Vertical?    @relation(fields: [verticalId], references: [id])
  owner      User         @relation("ScheduleOwner", fields: [ownerId], references: [id])
  manager    User         @relation("ScheduleManager", fields: [managerId], references: [id])
  approver   User?        @relation("ScheduleApprover", fields: [approverId], references: [id])
  instances  ComplianceInstance[]

  @@unique([locationId, complianceId])
  @@index([orgId, isActive])
  @@index([orgId, entityId])
  @@index([ownerId])
  @@index([managerId])
  @@index([complianceId])
}

model ComplianceInstance {
  id               String         @id @default(uuid())
  orgId            String
  scheduleId       String
  complianceId     String
  entityId         String
  locationId       String
  departmentId     String?
  verticalId       String?
  ownerId          String
  managerId        String
  approverId       String?
  requiresApprover Boolean        @default(false)
  periodStart      DateTime       @db.Date
  periodEnd        DateTime       @db.Date
  dueDate          DateTime       @db.Date
  status           InstanceStatus @default(DUE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  schedule   ComplianceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  compliance Compliance         @relation(fields: [complianceId], references: [id])
  entity     Entity             @relation(fields: [entityId], references: [id])
  location   Location           @relation(fields: [locationId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  vertical   Vertical?          @relation(fields: [verticalId], references: [id])
  owner      User               @relation("InstanceOwner", fields: [ownerId], references: [id])
  manager    User               @relation("InstanceManager", fields: [managerId], references: [id])
  approver   User?              @relation("InstanceApprover", fields: [approverId], references: [id])
  submissionType     SubmissionType?
  doneDate           DateTime?       @db.Date
  refNo              String?
  challanNo          String?
  actualImprisonment Boolean         @default(false)
  penaltyPaid        Decimal?        @db.Decimal(12, 2)
  payableAmount      Decimal?        @db.Decimal(12, 2)
  amountPaid         Decimal?        @db.Decimal(12, 2)
  remarks            String?
  returnRemarks      String?
  isWip              Boolean         @default(false)
  submittedAt        DateTime?
  submittedById      String?
  managerActionAt    DateTime?
  managerActionById  String?
  closedAt           DateTime?
  closedById         String?

  events InstanceEvent[]

  @@unique([scheduleId, periodStart])
  @@index([orgId, dueDate])
  @@index([orgId, status, dueDate])
  @@index([orgId, entityId, locationId])
  @@index([ownerId, status])
  @@index([managerId, status])
  @@index([complianceId])
}

enum SubmissionType {
  APPLICABLE
  NOT_APPLICABLE
}

enum InstanceAction {
  DRAFT_SAVED
  SUBMITTED
  MANAGER_APPROVED
  APPROVED
  RETURNED
  REASSIGNED
}

model InstanceEvent {
  id         String          @id @default(uuid())
  orgId      String
  instanceId String
  actorId    String
  action     InstanceAction
  fromStatus InstanceStatus?
  toStatus   InstanceStatus?
  remarks    String?
  data       Json?
  createdAt  DateTime        @default(now())

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  instance ComplianceInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor    User               @relation(fields: [actorId], references: [id])

  @@index([instanceId, createdAt])
  @@index([orgId, createdAt])
}
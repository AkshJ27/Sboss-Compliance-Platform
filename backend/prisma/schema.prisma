generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORG_ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  entities       Entity[]
  verticals      Vertical[]
  departments    Department[]
  locationTypes  LocationType[]
  locations      Location[]
  financialYears FinancialYear[]
  auditLogs      AuditLog[]
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]
  instanceEvents InstanceEvent[]
  documents Document[]
    documentRecords DocumentRecord[]
  docCategories   DocCategory[]
  notifications Notification[]
  eventTriggers EventTrigger[]
  amendmentDecisions AmendmentDecision[]
  tasks      Task[]
  taskEvents TaskEvent[]
    acts        Act[]
  compliances Compliance[]

}

model User {
  id               String    @id @default(uuid())
  orgId            String
  email            String    @unique
  name             String
  passwordHash     String
  role             Role      @default(MEMBER)
  isActive         Boolean   @default(true)
  isPlatformAdmin  Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  passwordSetAt DateTime? @default(now())
  authTokens    AuthToken[]
  eventTriggers EventTrigger[]
  amendmentDecisions AmendmentDecision[]

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
 instanceEvents InstanceEvent[]
  @@index([orgId])
  emailAlerts   Boolean        @default(true)
  notifications Notification[]
  assignedTasks Task[]      @relation("TaskAssignee")
  createdTasks  Task[]      @relation("TaskCreator")
  taskEvents    TaskEvent[]
  
  ownedSchedules    ComplianceSchedule[] @relation("ScheduleOwner")
  managedSchedules  ComplianceSchedule[] @relation("ScheduleManager")
  approvedSchedules ComplianceSchedule[] @relation("ScheduleApprover")
  ownedInstances    ComplianceInstance[] @relation("InstanceOwner")
  managedInstances  ComplianceInstance[] @relation("InstanceManager")
  approvedInstances ComplianceInstance[] @relation("InstanceApprover")
  uploadedDocuments Document[] @relation("DocumentUploader")
    ownedDocRecords   DocumentRecord[]     @relation("DocRecordOwner")
  managedDocRecords DocumentRecord[]     @relation("DocRecordManager")
  createdDocRecords DocumentRecord[]     @relation("DocRecordCreator")
  docRecordAccess   DocumentRecordUser[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Entity {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]
    documentRecords DocumentRecord[]
  eventTriggers EventTrigger[]
  tasks Task[]

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([orgId, name])
  @@unique([orgId, code])
  @@index([orgId])
}

model Vertical {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]
    documentRecords DocumentRecord[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

model Department {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]
    documentRecords DocumentRecord[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

model LocationType {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locations Location[]

  @@unique([orgId, name])
  @@index([orgId])
}

model Location {
  id             String   @id @default(uuid())
  orgId          String
  entityId       String
  locationTypeId String?
  name           String
  state          String
  city           String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]
    documentRecords DocumentRecord[]
  eventTriggers EventTrigger[]

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entity       Entity        @relation(fields: [entityId], references: [id])
  locationType LocationType? @relation(fields: [locationTypeId], references: [id])

  @@unique([entityId, name])
  @@index([orgId, entityId])
  @@index([orgId, state])
}

model FinancialYear {
  id        String   @id @default(uuid())
  orgId     String
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, label])
  @@index([orgId, startDate])
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  userId     String?
  action     String
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, entityId])
  @@index([orgId, createdAt])
}

enum Jurisdiction {
  CENTRAL
  STATE
}

enum Frequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  EVENT_BASED
}

enum PeriodBasis {
  FINANCIAL_YEAR
  CALENDAR_YEAR
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AttachmentRule {
  MANDATORY
  OPTIONAL
  NOT_REQUIRED
}

model LawCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  acts      Act[]
}

model StatutoryAuthority {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  acts      Act[]
}

model ComplianceNature {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  compliances Compliance[]
}

model ComplianceType {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  compliances Compliance[]
}

model Act {
  id                   String       @id @default(uuid())
  name                 String
  jurisdiction         Jurisdiction
  state                String?
  lawCategoryId        String
  statutoryAuthorityId String?
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  lawCategory        LawCategory         @relation(fields: [lawCategoryId], references: [id])
  statutoryAuthority StatutoryAuthority? @relation(fields: [statutoryAuthorityId], references: [id])
  orgId                String?
  org                Organization?       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  rules              Rule[]
  compliances        Compliance[]

  @@unique([name, jurisdiction, state])
  @@index([orgId])
  @@index([lawCategoryId])
  @@index([state])
}

model Rule {
  id        String   @id @default(uuid())
  actId     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  act         Act          @relation(fields: [actId], references: [id])
  compliances Compliance[]

  @@unique([actId, name])
  @@index([actId])
}

model Compliance {
  id                String         @id @default(uuid())
  code              String         @unique
  actId             String
  ruleId            String?
  natureId          String?
  typeId            String?
  title             String
  description       String?
  form              String?
  reference         String?
  risk              RiskLevel      @default(MEDIUM)
  impact            RiskLevel      @default(MEDIUM)
  attachment        AttachmentRule @default(OPTIONAL)
  frequency         Frequency
  periodBasis       PeriodBasis    @default(FINANCIAL_YEAR)
  dueDay            Int?
  dueMonthOffset    Int            @default(0)
  event             String?
  dueDaysAfterEvent Int?
  penalty           String?
  imprisonment      Boolean        @default(false)
  isActive          Boolean        @default(true)
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  orgId             String?
  applicability     String?
  proofOfCompliance String?
  alertOwnerDays    Int?
  alertManagerDays  Int?
  effectiveDate     DateTime?      @db.Date
  org       Organization?        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  schedules ComplianceSchedule[]
  instances ComplianceInstance[]
  amendmentDecisions AmendmentDecision[]

  act       Act                  @relation(fields: [actId], references: [id])
  rule      Rule?                @relation(fields: [ruleId], references: [id])
  nature    ComplianceNature?    @relation(fields: [natureId], references: [id])
  type      ComplianceType?      @relation(fields: [typeId], references: [id])
  revisions ComplianceRevision[]

    @@index([orgId])
  @@index([actId])
  @@index([ruleId])
  @@index([frequency])
  @@index([risk])
  @@index([isActive])
}

model ComplianceRevision {
  id           String   @id @default(uuid())
  complianceId String
  version      Int
  changes      Json
  changedById  String?
  createdAt    DateTime @default(now())

  compliance Compliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)

  @@unique([complianceId, version])
  @@index([complianceId])
}

enum InstanceStatus {
  DUE
  SUBMITTED
  MANAGER_APPROVED
  CLOSED
  RETURNED
  NOT_APPLICABLE
}

model ComplianceSchedule {
  id           String   @id @default(uuid())
  orgId        String
  complianceId String
  entityId     String
  locationId   String
  departmentId String?
  verticalId   String?
  ownerId      String
  managerId    String
  approverId   String?
  startDate    DateTime @db.Date
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  compliance Compliance   @relation(fields: [complianceId], references: [id])
  entity     Entity       @relation(fields: [entityId], references: [id])
  location   Location     @relation(fields: [locationId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])
  vertical   Vertical?    @relation(fields: [verticalId], references: [id])
  owner      User         @relation("ScheduleOwner", fields: [ownerId], references: [id])
  manager    User         @relation("ScheduleManager", fields: [managerId], references: [id])
  approver   User?        @relation("ScheduleApprover", fields: [approverId], references: [id])
  instances  ComplianceInstance[]
  libraryVersion    Int         
  frequency         Frequency   
  periodBasis       PeriodBasis 
  dueDay            Int?
  dueMonthOffset    Int         
  event             String?
  dueDaysAfterEvent Int?

  @@unique([locationId, complianceId])
  @@index([orgId, isActive])
  @@index([orgId, entityId])
  @@index([ownerId])
  @@index([managerId])
  @@index([complianceId])
}

model ComplianceInstance {
  id               String         @id @default(uuid())
  orgId            String
  scheduleId       String
  complianceId     String
  entityId         String
  locationId       String
  departmentId     String?
  verticalId       String?
  ownerId          String
  managerId        String
  approverId       String?
  requiresApprover Boolean        @default(false)
  periodStart      DateTime       @db.Date
  periodEnd        DateTime       @db.Date
  dueDate          DateTime       @db.Date
  status           InstanceStatus @default(DUE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  schedule   ComplianceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  compliance Compliance         @relation(fields: [complianceId], references: [id])
  entity     Entity             @relation(fields: [entityId], references: [id])
  location   Location           @relation(fields: [locationId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  vertical   Vertical?          @relation(fields: [verticalId], references: [id])
  owner      User               @relation("InstanceOwner", fields: [ownerId], references: [id])
  manager    User               @relation("InstanceManager", fields: [managerId], references: [id])
  approver   User?              @relation("InstanceApprover", fields: [approverId], references: [id])
  submissionType     SubmissionType?
  doneDate           DateTime?       @db.Date
  refNo              String?
  challanNo          String?
  actualImprisonment Boolean         @default(false)
  penaltyPaid        Decimal?        @db.Decimal(12, 2)
  payableAmount      Decimal?        @db.Decimal(12, 2)
  amountPaid         Decimal?        @db.Decimal(12, 2)
  remarks            String?
  returnRemarks      String?
  isWip              Boolean         @default(false)
  submittedAt        DateTime?
  submittedById      String?
  managerActionAt    DateTime?
  managerActionById  String?
  closedAt           DateTime?
  closedById         String?
  triggerId String?
  trigger   EventTrigger? @relation(fields: [triggerId], references: [id])

  @@index([triggerId])

  events InstanceEvent[]
  documents Document[]
  @@unique([scheduleId, periodStart])
  @@index([orgId, dueDate])
  @@index([orgId, status, dueDate])
  @@index([orgId, entityId, locationId])
  @@index([ownerId, status])
  @@index([managerId, status])
  @@index([complianceId])
}

enum SubmissionType {
  APPLICABLE
  NOT_APPLICABLE
}

enum InstanceAction {
  DRAFT_SAVED
  SUBMITTED
  MANAGER_APPROVED
  APPROVED
  RETURNED
  REASSIGNED
  DUE_DATE_CHANGED
}

model InstanceEvent {
  id         String          @id @default(uuid())
  orgId      String
  instanceId String
  actorId    String
  action     InstanceAction
  fromStatus InstanceStatus?
  toStatus   InstanceStatus?
  remarks    String?
  data       Json?
  createdAt  DateTime        @default(now())

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  instance ComplianceInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor    User               @relation(fields: [actorId], references: [id])

  @@index([instanceId, createdAt])
  @@index([orgId, createdAt])
}

enum AccessLevel {
  PUBLIC
  PRIVATE
  PROTECTED
  RESTRICTED
}

model Document {
  id           String      @id @default(uuid())
  orgId        String
  instanceId   String?
    recordId     String?
  title        String
  description  String?
  docNumber    String?
  accessLevel  AccessLevel @default(PROTECTED)
  expiresAt    DateTime?   @db.Date
  fileName     String
  contentType  String
  sizeBytes    Int
  sha256       String
  storageKey   String      @unique
  uploadedById String
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  org        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  instance   ComplianceInstance? @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  uploadedBy User                @relation("DocumentUploader", fields: [uploadedById], references: [id])
    record     DocumentRecord?     @relation(fields: [recordId], references: [id], onDelete: Restrict)

  @@index([instanceId])
    @@index([recordId])
  @@index([orgId, createdAt])
  @@index([orgId, expiresAt])
}


// ---- Document repository (the Documents menu) ------------------------------------------

// Category, sub category and sub sub category in one tree, per company
model DocCategory {
  id        String   @id @default(uuid())
  orgId     String
  parentId  String?
  level     Int // 1 category, 2 sub category, 3 sub sub category
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   DocCategory?  @relation("DocCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children DocCategory[] @relation("DocCategoryTree")

  asCategory       DocumentRecord[] @relation("DocRecordCategory")
  asSubCategory    DocumentRecord[] @relation("DocRecordSubCategory")
  asSubSubCategory DocumentRecord[] @relation("DocRecordSubSubCategory")

  @@unique([orgId, parentId, name])
  @@index([orgId, level])
}

// One document in the repository. Its files are Document rows with recordId set.
model DocumentRecord {
  id               String      @id @default(uuid())
  orgId            String
  entityId         String
  verticalId       String
  locationId       String
  departmentId     String
  categoryId       String
  subCategoryId    String?
  subSubCategoryId String?
  name             String
  docNumber        String?
  accessLevel      AccessLevel @default(PROTECTED)
  storedAt         String? // where the physical copy is kept
  ownerId          String
  managerId        String?
  reviewDate       DateTime?   @db.Date
  expiryDate       DateTime?   @db.Date
  alertDays        Int?
  remarks          String?
  createdById      String
  deletedAt        DateTime?
  deletedById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entity         Entity       @relation(fields: [entityId], references: [id])
  vertical       Vertical     @relation(fields: [verticalId], references: [id])
  location       Location     @relation(fields: [locationId], references: [id])
  department     Department   @relation(fields: [departmentId], references: [id])
  category       DocCategory  @relation("DocRecordCategory", fields: [categoryId], references: [id])
  subCategory    DocCategory? @relation("DocRecordSubCategory", fields: [subCategoryId], references: [id])
  subSubCategory DocCategory? @relation("DocRecordSubSubCategory", fields: [subSubCategoryId], references: [id])
  owner          User         @relation("DocRecordOwner", fields: [ownerId], references: [id])
  manager        User?        @relation("DocRecordManager", fields: [managerId], references: [id])
  createdBy      User         @relation("DocRecordCreator", fields: [createdById], references: [id])

  files           Document[]
  additionalUsers DocumentRecordUser[]

  @@index([orgId, createdAt])
  @@index([orgId, expiryDate])
  @@index([orgId, ownerId])
  @@index([categoryId])
}

// People given access to a document on top of its owner and manager
model DocumentRecordUser {
  recordId String
  userId   String

  record DocumentRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([recordId, userId])
  @@index([userId])
}

enum NotificationType {
  REVIEW_REQUESTED
  RETURNED
  CLOSED
  LAW_CHANGE
  ASSIGNED
  EVENT_TRIGGERED
  DAILY_DIGEST
  TASK_ASSIGNED
  TASK_UPDATED
    DOCUMENT_EXPIRING
}

enum EmailStatus {
  NONE
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model Notification {
  id                 String           @id @default(uuid())
  orgId              String
  userId             String
  type               NotificationType
  title              String
  body               String
  instanceId         String?
  dedupeKey          String?
  readAt             DateTime?
  emailStatus        EmailStatus      @default(NONE)
  emailAttempts      Int              @default(0)
  emailLastAttemptAt DateTime?
  emailedAt          DateTime?
  createdAt          DateTime         @default(now())
  taskId String?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([emailStatus, createdAt])
  @@index([createdAt])
}

model JobRun {
  id         String    @id @default(uuid())
  name       String
  runKey     String
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json?
  error      String?

  @@unique([name, runKey])
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id          String        @id @default(uuid())
  userId      String
  type        AuthTokenType
  tokenHash   String        @unique
  expiresAt   DateTime
  usedAt      DateTime?     // set when the link is used or replaced by a newer one
  createdById String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([expiresAt])
}

model EventTrigger {
  id            String    @id @default(uuid())
  orgId         String
  entityId      String
  locationId    String
  event         String
  eventDate     DateTime  @db.Date
  note          String?
  createdById   String
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  cancelledById String?

  org       Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entity    Entity               @relation(fields: [entityId], references: [id])
  location  Location             @relation(fields: [locationId], references: [id])
  createdBy User                 @relation(fields: [createdById], references: [id])
  instances ComplianceInstance[]

  @@index([orgId, createdAt])
  @@index([locationId, eventDate])
}

enum AmendmentDecisionType {
  APPLIED
  KEPT
  ACKNOWLEDGED
}

model AmendmentDecision {
  id               String                @id @default(uuid())
  orgId            String
  complianceId     String
  decision         AmendmentDecisionType
  fromVersion      Int
  toVersion        Int
  changes          Json
  schedulesUpdated Int
  itemsMoved       Int
  note             String?
  decidedById      String
  createdAt        DateTime              @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  compliance Compliance   @relation(fields: [complianceId], references: [id])
  decidedBy  User         @relation(fields: [decidedById], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, complianceId])
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskAction {
  CREATED
  UPDATED
  REASSIGNED
  STATUS_CHANGED
  COMMENTED
}

model Task {
  id          String       @id @default(uuid())
  orgId       String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  entityId    String?
  assigneeId  String
  createdById String
  dueDate     DateTime?    @db.Date
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entity    Entity?      @relation(fields: [entityId], references: [id])
  assignee  User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User         @relation("TaskCreator", fields: [createdById], references: [id])
  events    TaskEvent[]

  @@index([orgId, status, dueDate])
  @@index([assigneeId, status])
  @@index([createdById])
}

model TaskEvent {
  id         String      @id @default(uuid())
  orgId      String
  taskId     String
  actorId    String
  action     TaskAction
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  remarks    String?
  data       Json?
  createdAt  DateTime    @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task  Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User         @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}